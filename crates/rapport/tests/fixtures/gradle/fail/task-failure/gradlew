#!/bin/sh
set -u

if ! command -v java >/dev/null 2>&1; then
    echo "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
    exit 1
fi

if [ "${1:-}" != "--no-daemon" ]; then
    echo "unexpected gradle args: $*" >&2
    exit 2
fi

task="${2:-}"
if [ "$task" = "assemble" ]; then
    echo "Starting a Gradle Daemon would be disabled by --no-daemon"
    echo "> Task :app:mergeLocalDebugResources"
    echo "> Task :app:compileLocalDebugKotlin FAILED"
    echo "hundreds of noisy compiler lines omitted by rapport"
    echo "Execution failed for task ':app:compileLocalDebugKotlin'." >&2
    echo "> Compilation error. See log for details." >&2
    echo "com.rapport.GreeterTest > saysHello FAILED" >&2
    echo "app/src/main/AndroidManifest.xml:12: Error: Missing application icon [IconMissingDensityFolder]" >&2
    echo "BUILD FAILED in 3s" >&2
    exit 1
fi

echo "> Task :$task"
echo "$task passed"
echo "BUILD SUCCESSFUL in 1s"
