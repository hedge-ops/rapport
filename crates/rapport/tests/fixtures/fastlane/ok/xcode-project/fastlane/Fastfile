default_platform(:ios)

lane :build do
  sh("xcodebuild -project App.xcodeproj -scheme App build")
end

lane :test do
  sh("xcodebuild -project App.xcodeproj -scheme App test")
end

lane :lint do
  sh("xcodebuild -project App.xcodeproj -scheme App analyze")
end

lane :fix do
  UI.message("format app sources")
end

lane :validate do
  build
  test
  lint
end

lane :audit do
  validate
  sh("xcodebuild -project App.xcodeproj -scheme App archive")
end
